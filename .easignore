# API reference docs (not needed at runtime)
bizyair.api.reference/

# IDE
.claude/
.vscode/
.idea/

# Env files (use EAS environment variables instead)
.env.example

# Lock file optional (EAS uses this but can speed up by excluding)
# package-lock.json
